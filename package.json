{
  "name": "chai.im",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:wasm": "cd crates/chai-crypto && wasm-pack build --target web --features wasm --out-dir ../../apps/web/wasm",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "clean": "turbo clean && rm -rf node_modules",
    "server:dev": "cargo run -p chai-server",
    "server:build": "cargo build -p chai-server --release",
    "cli:dev": "cargo run -p chai-cli",
    "cli:build": "cargo build -p chai-cli --release"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.5.5",
      "@protobufjs/utf8": ">=1.1.1",
      "ws": ">=8.20.1",
      "browserslist": ">=4.28.7",
      "@babel/core": ">=7.29.6",
      "baseline-browser-mapping": ">=2.11.0",
      "@humanfs/node": ">=0.16.8",
      "flatted": ">=3.4.0",
      "source-map-js": ">=1.2.2",
      "brace-expansion": ">=2.1.7",
      "rollup": ">=4.59.0",
      "js-yaml": "^4.2.0",
      "sharp": ">=0.35.5"
    }
  }
}
